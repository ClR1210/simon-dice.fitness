---
import Layout from '../layouts/Layout.astro';

// Contactos Oficiales
const WHATSAPP_NUM = "56937324552"; 
const CALENDLY_URL = "https://calendly.com/larosarocuant/new-meeting"; 

const MSG_BASE = encodeURIComponent("¡Hola Simón! Quiero pedirte información sobre los entrenamientos.");
const WA_LINK = `https://wa.me/${WHATSAPP_NUM}?text=${MSG_BASE}`;
---

<Layout title="SIMON DICE FITNESS | Taller de Boxeo y Preparador Físico">
  <!-- HERO CON FONDO OFICIAL MEJORADO (Más contraste) -->
  <header class="relative min-h-[95vh] flex items-center justify-center text-center px-4 overflow-hidden">
    <!-- Fondo original oscurecido para resaltar el texto -->
    <div 
      class="absolute inset-0 bg-cover bg-center bg-no-repeat filter brightness-[0.25] scale-105" 
      style="background-image: url('/banner-fondo.jpeg');"
    ></div>

    <!-- Degradado negro intenso para separar la letra del fondo -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/90 via-black/60 to-brand-dark pointer-events-none"></div>

    <div class="relative z-10 max-w-3xl mx-auto flex flex-col items-center pt-8" data-aos="zoom-in">
      <!-- Logo Circular -->
      <div class="relative mb-8 group">
        <div class="absolute -inset-2 rounded-full bg-gradient-to-r from-brand-gold to-yellow-600 opacity-60 blur-xl group-hover:opacity-100 transition duration-500"></div>
        <img 
          src="/logo-circular.jpeg" 
          alt="Simon Dice Fitness Logo" 
          class="relative w-40 h-40 md:w-48 md:h-48 rounded-full border-[3px] border-brand-gold object-cover shadow-[0_0_30px_rgba(0,0,0,1)]"
        />
      </div>

      <!-- Badge de ubicación -->
      <div class="inline-flex items-center gap-2 border border-brand-gold/80 bg-black/50 text-brand-gold text-sm md:text-base font-black uppercase tracking-widest px-6 py-2 rounded-full mb-6 backdrop-blur-md shadow-[0_5px_15px_rgba(0,0,0,0.8)]">
        <span class="text-xl">📍</span> Nocedal 1 • San Bernardo
      </div>
      
      <!-- Título con drop-shadow fuerte para legibilidad extrema -->
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight uppercase text-white drop-shadow-[0_5px_5px_rgba(0,0,0,1)]">
        SIMON DICE <span class="text-brand-gold block md:inline drop-shadow-[0_5px_10px_rgba(0,0,0,1)]">FITNESS</span>
      </h1>

      <p class="text-xl md:text-2xl text-neutral-200 font-bold italic mt-6 mb-10 drop-shadow-[0_2px_4px_rgba(0,0,0,1)]">
        "El esfuerzo de hoy es la fuerza de mañana."
      </p>

      <div class="flex flex-col sm:flex-row gap-4 w-full justify-center max-w-md">
        <a 
          href="#servicios" 
          class="w-full sm:w-auto px-8 py-3.5 rounded-lg bg-brand-gold hover:bg-brand-goldLight text-black font-extrabold uppercase tracking-wider transition-all transform hover:scale-105 shadow-[0_0_20px_rgba(229,169,60,0.4)]"
        >
          Ver Servicios
        </a>
        <a 
          href={WA_LINK} 
          target="_blank" 
          class="w-full sm:w-auto px-8 py-3.5 rounded-lg border-2 border-brand-gold/50 bg-black/60 backdrop-blur-md hover:bg-brand-gold/10 text-white font-bold uppercase tracking-wider transition-all shadow-xl"
        >
          Consultar WhatsApp
        </a>
      </div>
    </div>
  </header>

  <!-- SECCIÓN DOS CAMINOS (TARJETAS CON FONDOS DINÁMICOS) -->
  <section id="servicios" class="py-20 px-4 max-w-6xl mx-auto scroll-mt-12">
    <h2 class="text-center text-4xl font-extrabold uppercase mb-12 drop-shadow-md" data-aos="fade-up">
      Elige tu <span class="text-brand-gold">Entrenamiento</span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- CAMINO 1: TALLER GRUPAL -->
      <div class="relative group rounded-2xl overflow-hidden border-2 border-brand-border hover:border-brand-gold transition-all shadow-2xl" data-aos="fade-right">
        <!-- Fondo con imagen -->
        <div class="absolute inset-0 bg-[url('/banner-fondo.jpeg')] bg-cover bg-center opacity-20 group-hover:opacity-40 transition-opacity duration-500 filter grayscale group-hover:grayscale-0"></div>
        <!-- Capa de color base -->
        <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-brand-dark/90 to-black/80"></div>
        
        <!-- Contenido Tarjeta -->
        <div class="relative z-10 p-10 text-center flex flex-col items-center h-full">
          <div class="text-6xl mb-4 drop-shadow-[0_0_15px_rgba(229,169,60,0.5)]">🥊</div>
          <h3 class="text-3xl font-black uppercase text-white mb-3">Taller de Boxeo</h3>
          <p class="text-neutral-300 mb-8 font-medium">Entrenamiento grupal enfocado en técnica, acondicionamiento y guanteo. Ideal para todos los niveles.</p>
          <a href="#taller-info" class="mt-auto px-6 py-4 w-full border-2 border-brand-gold text-brand-gold hover:bg-brand-gold hover:text-black font-extrabold uppercase tracking-widest rounded-lg transition-colors bg-black/40 backdrop-blur-sm">
            Ver Taller y Planes
          </a>
        </div>
      </div>

      <!-- CAMINO 2: PREPARADOR FÍSICO / CLASES PARTICULARES -->
      <div class="relative group rounded-2xl overflow-hidden border-2 border-brand-border hover:border-brand-gold transition-all shadow-2xl" data-aos="fade-left">
        <!-- Fondo radial dinámico -->
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-yellow-900/20 via-brand-dark to-black opacity-80 group-hover:opacity-100 transition-opacity duration-500"></div>
        
        <!-- Contenido Tarjeta -->
        <div class="relative z-10 p-10 text-center flex flex-col items-center h-full">
          <div class="text-6xl mb-4 drop-shadow-[0_0_15px_rgba(229,169,60,0.5)]">⚡</div>
          <h3 class="text-3xl font-black uppercase text-white mb-3">Preparador Físico</h3>
          <p class="text-neutral-300 mb-8 font-medium">Clases particulares 1 a 1. Acondicionamiento funcional, hipertrofia o boxeo personalizado según tu horario.</p>
          <a href="#agenda-calendly" class="mt-auto px-6 py-4 w-full bg-brand-gold text-black hover:bg-brand-goldLight font-extrabold uppercase tracking-widest rounded-lg transition-colors shadow-[0_0_20px_rgba(229,169,60,0.3)]">
            Agendar Evaluación
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- DETALLES DEL TALLER GRUPAL -->
  <div id="taller-info" class="pt-16 pb-4 scroll-mt-12">
    <!-- AFICHE Y MAPA -->
    <section class="px-4 max-w-5xl mx-auto mb-20">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <!-- Afiche -->
        <div class="w-full md:w-1/2 flex justify-center" data-aos="fade-right">
          <div class="relative group max-w-sm rounded-2xl overflow-hidden border-2 border-brand-gold shadow-[0_0_40px_rgba(229,169,60,0.2)]">
            <img src="/afiche.jpg" alt="Afiche Taller de Boxeo" class="w-full h-auto object-cover" />
          </div>
        </div>

        <!-- Textos y Mapa -->
        <div class="w-full md:w-1/2 space-y-6 text-center md:text-left" data-aos="fade-left">
          <h2 class="text-3xl md:text-5xl font-extrabold uppercase text-white leading-tight">
            Aprende Técnica y <span class="text-brand-gold">Disciplina</span>
          </h2>
          <p class="text-neutral-300 text-lg leading-relaxed">
            Entrenamiento funcional, guardia, desplazamientos y manopleo directo en nuestra sede. Diseñado para quienes parten desde cero o buscan mejorar su nivel.
          </p>
          
          <!-- Contenedor del Mapa Corregido -->
          <div class="bg-[#111] p-4 rounded-xl border border-brand-border shadow-lg">
            <div class="flex items-center gap-3 justify-center md:justify-start mb-4">
              <div class="text-3xl text-brand-gold animate-bounce">📍</div>
              <div class="text-left">
                <p class="text-xs text-brand-gold uppercase tracking-widest font-black">Sede Oficial</p>
                <p class="text-white font-bold text-lg">Nocedal 1, San Bernardo</p>
              </div>
            </div>
            
            <!-- Google Maps con dirección exacta corregida -->
            <div class="w-full h-56 rounded-lg overflow-hidden border border-brand-border/50">
              <iframe 
                src="https://maps.google.com/maps?q=Nocedal%201,%20San%20Bernardo,%20Chile&t=&z=15&ie=UTF8&iwloc=&output=embed" 
                width="100%" 
                height="100%" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade">
              </iframe>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- HORARIOS -->
    <section class="py-16 px-4 bg-black/80 border-y border-brand-border mb-20 relative overflow-hidden">
      <!-- Decoración de fondo en horarios -->
      <div class="absolute inset-0 bg-[radial-gradient(#E5A93C_1px,transparent_1px)] [background-size:20px_20px] opacity-10 pointer-events-none"></div>
      
      <div class="max-w-4xl mx-auto relative z-10">
        <h2 class="text-center text-3xl font-black uppercase text-brand-gold tracking-widest mb-10 drop-shadow-md" data-aos="fade-up">
          ★ Horarios Taller Grupal ★
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-brand-card border-2 border-brand-border rounded-xl p-6 text-center shadow-xl hover:-translate-y-2 transition-transform duration-300" data-aos="fade-up" data-aos-delay="100">
            <span class="text-brand-gold font-black uppercase tracking-widest text-sm">Lunes</span>
            <p class="text-3xl font-black mt-2 text-white">22:15<br/><span class="text-lg text-neutral-500 font-bold">a 23:30</span></p>
          </div>
          <div class="bg-brand-card border-2 border-brand-border rounded-xl p-6 text-center shadow-xl hover:-translate-y-2 transition-transform duration-300" data-aos="fade-up" data-aos-delay="200">
            <span class="text-brand-gold font-black uppercase tracking-widest text-sm">Miércoles</span>
            <p class="text-3xl font-black mt-2 text-white">22:30<br/><span class="text-lg text-neutral-500 font-bold">a 23:45</span></p>
          </div>
          <div class="bg-brand-card border-2 border-brand-border rounded-xl p-6 text-center shadow-xl hover:-translate-y-2 transition-transform duration-300" data-aos="fade-up" data-aos-delay="300">
            <span class="text-brand-gold font-black uppercase tracking-widest text-sm">Jueves</span>
            <p class="text-3xl font-black mt-2 text-white">22:30<br/><span class="text-lg text-neutral-500 font-bold">a 23:45</span></p>
          </div>
        </div>
      </div>
    </section>

    <!-- PLANES -->
    <section class="px-4 max-w-5xl mx-auto pb-10">
      <h3 class="text-center text-4xl font-extrabold uppercase mb-12" data-aos="fade-up">Planes del <span class="text-brand-gold">Taller</span></h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        
        <!-- Básico -->
        <div class="bg-brand-card border border-brand-border rounded-2xl p-8 flex flex-col justify-between shadow-lg hover:border-brand-gold transition-colors" data-aos="fade-right">
          <div>
            <h4 class="text-2xl font-black uppercase text-white">Plan Básico</h4>
            <p class="text-brand-gold font-bold mt-1 uppercase text-sm tracking-wider">2 clases por semana</p>
            <ul class="mt-8 space-y-4 text-base text-neutral-300 font-medium">
              <li class="flex items-start gap-3"><span class="text-brand-gold">✔</span> Fundamentos de guardia y desplazamiento</li>
              <li class="flex items-start gap-3"><span class="text-brand-gold">✔</span> Acondicionamiento físico general</li>
            </ul>
          </div>
          <a href={`https://wa.me/${WHATSAPP_NUM}?text=${encodeURIComponent("Hola Simón, quiero inscribirme al Taller con el Plan Básico. Te envío comprobante.")}`} target="_blank" class="mt-10 block text-center py-4 rounded-xl border-2 border-brand-gold text-brand-gold hover:bg-brand-gold hover:text-black font-black uppercase tracking-widest transition-all">
            Inscribirme
          </a>
        </div>

        <!-- Completo -->
        <div class="bg-gradient-to-br from-[#1a160d] to-brand-card border-2 border-brand-gold rounded-2xl p-8 flex flex-col justify-between relative shadow-[0_0_30px_rgba(229,169,60,0.15)] transform md:-translate-y-4" data-aos="fade-left">
          <span class="absolute -top-4 right-8 bg-brand-gold text-black text-xs font-black uppercase px-4 py-1.5 rounded-full shadow-lg">El más completo</span>
          <div>
            <h4 class="text-2xl font-black uppercase text-white">Plan Completo</h4>
            <p class="text-brand-gold font-bold mt-1 uppercase text-sm tracking-wider">3 clases por semana</p>
            <ul class="mt-8 space-y-4 text-base text-neutral-300 font-medium">
              <li class="flex items-start gap-3"><span class="text-brand-gold">✔</span> Lunes, Miércoles y Jueves</li>
              <li class="flex items-start gap-3"><span class="text-brand-gold">✔</span> Trabajo en saco, manoplas y sparring</li>
              <li class="flex items-start gap-3"><span class="text-brand-gold">✔</span> Corrección de técnica avanzada</li>
            </ul>
          </div>
          <a href={`https://wa.me/${WHATSAPP_NUM}?text=${encodeURIComponent("Hola Simón, quiero inscribirme al Taller con el Plan Completo. Te envío comprobante.")}`} target="_blank" class="mt-10 block text-center py-4 rounded-xl bg-brand-gold hover:bg-brand-goldLight text-black font-black uppercase tracking-widest transition-all shadow-[0_0_15px_rgba(229,169,60,0.4)]">
            Inscribirme
          </a>
        </div>
      </div>
    </section>
  </div>

  <!-- SECCIÓN CALENDLY PARA PARTICULARES -->
  <section id="agenda-calendly" class="py-20 px-4 bg-black border-t border-brand-border scroll-mt-12">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10" data-aos="fade-up">
        <h2 class="text-3xl md:text-5xl font-extrabold uppercase text-white drop-shadow-md">
          Agenda tu <span class="text-brand-gold">Clase Particular</span>
        </h2>
        <p class="text-neutral-400 mt-4 max-w-2xl mx-auto text-lg">
          Selecciona el día y la hora que más te acomode para tu sesión 1 a 1. Preparación física o boxeo focalizado totalmente a tu ritmo.
        </p>
      </div>

      <!-- Widget Calendly -->
      <div class="bg-brand-card border-2 border-brand-border rounded-xl p-2 md:p-4 shadow-[0_0_40px_rgba(0,0,0,0.5)] overflow-hidden relative" data-aos="zoom-in" data-aos-delay="200">
        <div class="absolute inset-0 bg-brand-gold/5 blur-3xl rounded-full pointer-events-none"></div>
        <div class="calendly-inline-widget relative z-10" data-url={`${CALENDLY_URL}?hide_gdpr_banner=1&background_color=141414&text_color=ffffff&primary_color=e5a93c`} style="min-width:320px;height:700px;"></div>
        <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
      </div>
    </div>
  </section>

  <!-- REDES SOCIALES Y FOOTER -->
  <footer class="bg-[#050505] pt-16 pb-8 border-t-2 border-brand-gold/30">
    <div class="max-w-4xl mx-auto px-4 flex flex-col items-center text-center">
      
      <!-- Frase de poder -->
      <h2 class="text-2xl md:text-3xl font-black text-white uppercase italic tracking-tight mb-2">
        "No es solo deporte, <span class="text-brand-gold">es disciplina.</span>"
      </h2>
      <p class="text-neutral-500 font-medium mb-10">Únete a la manada y síguenos en nuestras redes oficiales.</p>

      <!-- Botones de Redes -->
      <div class="flex gap-6 mb-12">
        <!-- Instagram -->
        <a href="https://instagram.com/simon_dice_fitness" target="_blank" class="group flex items-center justify-center w-14 h-14 rounded-full bg-brand-card border border-brand-border hover:border-brand-gold hover:bg-brand-gold/10 transition-all duration-300 shadow-lg">
          <svg class="w-6 h-6 text-neutral-300 group-hover:text-brand-gold transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
          </svg>
        </a>
        <!-- TikTok -->
        <a href="https://tiktok.com/@simon_dice_fitness" target="_blank" class="group flex items-center justify-center w-14 h-14 rounded-full bg-brand-card border border-brand-border hover:border-brand-gold hover:bg-brand-gold/10 transition-all duration-300 shadow-lg">
          <svg class="w-5 h-5 text-neutral-300 group-hover:text-brand-gold transition-colors" fill="currentColor" viewBox="0 0 448 512">
            <path d="M448,209.91a210.06,210.06,0,0,1-122.77-39.25V349.38A162.55,162.55,0,1,1,185,188.31V278.2a74.62,74.62,0,1,0,52.23,71.18V0l88,0a121.18,121.18,0,0,0,1.86,22.17h0A122.18,122.18,0,0,0,381,102.39a121.43,121.43,0,0,0,67,20.14Z"/>
          </svg>
        </a>
        <!-- WhatsApp -->
        <a href={WA_LINK} target="_blank" class="group flex items-center justify-center w-14 h-14 rounded-full bg-brand-card border border-brand-border hover:border-brand-gold hover:bg-brand-gold/10 transition-all duration-300 shadow-lg">
          <svg class="w-6 h-6 text-neutral-300 group-hover:text-brand-gold transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12.031 0C5.385 0 0 5.386 0 12.031c0 2.12.552 4.148 1.597 5.952L.15 23.344l5.51-1.446A11.966 11.966 0 0012.031 24c6.645 0 12.031-5.385 12.031-12.031S18.677 0 12.031 0zm0 22.022a9.923 9.923 0 01-5.074-1.39l-.364-.216-3.774.99.998-3.68-.236-.376A9.914 9.914 0 012.053 12.03c0-5.503 4.478-9.98 9.978-9.98 5.503 0 9.98 4.477 9.98 9.98s-4.477 9.98-9.98 9.98zm5.474-7.466c-.3-.15-1.776-.877-2.053-.977-.275-.1-.475-.15-.675.15-.2.3-.775.976-.95 1.176-.176.2-.35.226-.65.076a8.212 8.212 0 01-2.417-1.492 9.07 9.07 0 01-1.674-2.079c-.175-.3-.02-.463.13-.613.135-.136.3-.35.45-.526.15-.175.2-.3.3-.5.1-.2.05-.375-.025-.525-.075-.15-.675-1.626-.925-2.226-.24-.585-.487-.506-.675-.516l-.575-.01c-.2 0-.525.075-.8.375-.275.3-1.05 1.026-1.05 2.5 0 1.475 1.075 2.902 1.225 3.102.15.2 2.115 3.226 5.12 4.527 2.055.89 2.76.715 3.26.602.552-.126 1.776-.726 2.026-1.427.25-.7.25-1.301.175-1.427-.075-.125-.275-.2-.575-.35z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>

      <p class="text-neutral-600 text-sm font-semibold tracking-wide">
        © 2026 Simon Dice Fitness.<br/>San Bernardo, RM, Chile.
      </p>
    </div>
  </footer>

</Layout>