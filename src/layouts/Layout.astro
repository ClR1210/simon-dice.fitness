---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <!-- Estilos de AOS -->
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
  </head>
  <body class="bg-brand-dark text-white font-sans antialiased overflow-x-hidden selection:bg-brand-gold selection:text-black">
    <slot />

    <!-- Script para activar animaciones AOS -->
    <script>
      import AOS from 'aos';
      AOS.init({
        duration: 800,
        once: true,
        easing: 'ease-out-cubic',
      });
    </script>
  </body>
</html>